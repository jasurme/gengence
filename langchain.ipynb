   "source": [
    "import \n",
    "def tool(func):\n",
    "    toolname = func.__name__\n",
    "    tool_desc = func.__doc__\n",
    "    if not func.__doc__:\n",
    "        raise ValueError(\"tools must have docstring explaining what the tool does and its parameters, expected output\")\n",
    "    else: tool_desc = func.__\n"
   ]
  }
